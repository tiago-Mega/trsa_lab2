#!/usr/bin/env python3
"""Installed runtime dependencies; intentionally does not solve/grade templates."""
import importlib
from ament_index_python.packages import get_package_share_directory
for module in ('sensor_adapter','wheel_odom_interface','nav_check','fusion_record'):
    importlib.import_module('trsa_warehouse.'+module)
for package in ('robot_localization','slam_toolbox','nav2_controller','dwb_critics',
 'nav2_planner','nav2_navfn_planner','nav2_smoother','nav2_behaviors','nav2_bt_navigator',
 'nav2_waypoint_follower','nav2_velocity_smoother','nav2_collision_monitor','nav2_map_server','nav2_amcl',
 'nav2_lifecycle_manager','nav2_rviz_plugins'):
    get_package_share_directory(package)
print('Installed runtime imports checked; unfinished student templates are not executed.')
